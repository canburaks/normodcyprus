{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "productCollageSlots": {
      "minItems": 6,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "small": {
            "type": "object",
            "properties": {
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "span": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "row": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "rowSpan": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "column",
              "span",
              "row",
              "rowSpan"
            ],
            "additionalProperties": false
          },
          "medium": {
            "type": "object",
            "properties": {
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "span": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "row": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "rowSpan": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "column",
              "span",
              "row",
              "rowSpan"
            ],
            "additionalProperties": false
          },
          "large": {
            "type": "object",
            "properties": {
              "column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "span": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "row": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "rowSpan": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "column",
              "span",
              "row",
              "rowSpan"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "small",
          "medium",
          "large"
        ],
        "additionalProperties": false
      }
    },
    "collectionFrame": {
      "type": "object",
      "properties": {
        "ratio": {
          "type": "string",
          "enum": [
            "portrait",
            "landscape",
            "hero",
            "square",
            "natural"
          ]
        },
        "fit": {
          "type": "string",
          "enum": [
            "cover",
            "contain"
          ]
        },
        "position": {
          "type": "string",
          "pattern": "^(?:100|\\d{1,2})% (?:100|\\d{1,2})%$"
        }
      },
      "required": [
        "ratio",
        "fit",
        "position"
      ],
      "additionalProperties": false
    },
    "collectionSpans": {
      "type": "object",
      "properties": {
        "small": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "medium": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "large": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      },
      "required": [
        "small",
        "medium",
        "large"
      ],
      "additionalProperties": false
    },
    "navigationPreviewAssetId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  },
  "required": [
    "productCollageSlots",
    "collectionFrame",
    "collectionSpans",
    "navigationPreviewAssetId"
  ],
  "additionalProperties": false
}
