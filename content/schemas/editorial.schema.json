{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "isPublished": {
      "type": "boolean"
    },
    "heroAssetId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": {
            "type": "string",
            "const": "text"
          }
        },
        "required": [
          "id",
          "type"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "isPublished",
    "heroAssetId",
    "source",
    "sections"
  ],
  "additionalProperties": false
}
