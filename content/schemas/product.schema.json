{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "isPublished": {
      "type": "boolean"
    },
    "categoryId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "materialIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "collectionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "galleryAssetIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "sortOrder": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "relatedIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "frame": {
          "type": "object",
          "properties": {
            "ratio": {
              "type": "string",
              "enum": [
                "portrait",
                "landscape",
                "hero",
                "square",
                "natural"
              ]
            },
            "fit": {
              "type": "string",
              "enum": [
                "cover",
                "contain"
              ]
            },
            "position": {
              "type": "string",
              "pattern": "^(?:100|\\d{1,2})% (?:100|\\d{1,2})%$"
            }
          },
          "required": [
            "ratio",
            "fit",
            "position"
          ],
          "additionalProperties": false
        },
        "hoverBackground": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "detailRatio": {
          "type": "string",
          "enum": [
            "portrait",
            "square",
            "natural"
          ]
        },
        "hoverForeground": {
          "type": "string",
          "enum": [
            "#FFFFFF",
            "#0A0A0A"
          ]
        }
      },
      "required": [
        "frame",
        "hoverBackground",
        "detailRatio",
        "hoverForeground"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "isPublished",
    "categoryId",
    "materialIds",
    "collectionIds",
    "galleryAssetIds",
    "dimensions",
    "source",
    "verifiedAt",
    "sortOrder",
    "relatedIds",
    "presentation"
  ],
  "additionalProperties": false
}
