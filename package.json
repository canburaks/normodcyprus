{
  "name": "normodcyprus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm content:validate && pnpm design:generate && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prebuild": "pnpm content:validate && pnpm content:lint && pnpm design:generate && pnpm seo:generate",
    "typecheck": "next typegen && tsc --noEmit",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:schemas": "tsx scripts/generate-schemas.ts",
    "design:generate": "tsx scripts/generate-design.ts",
    "seo:generate": "tsx scripts/generate-seo.ts",
    "test": "tsx --test tests/*.test.ts",
    "assets:check": "tsx scripts/check-assets.ts",
    "audit:production": "python3 scripts/audit-production.py",
    "format": "prettier --write src scripts tests next.config.ts next-i18next.config.cjs",
    "format:check": "prettier --check src scripts tests next.config.ts next-i18next.config.cjs",
    "content:lint": "tsx scripts/audit-ui.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@mdx-js/mdx": "^3.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-i18next": "^16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.14",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.3.4",
  "type": "module"
}
